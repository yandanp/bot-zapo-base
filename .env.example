# ───────────────────────────────────────────────
#  bot-zapo environment configuration
#  Copy this file to `.env` and adjust as needed.
# ───────────────────────────────────────────────

# Session identifier (lets you run multiple sessions against one store file)
SESSION_ID=default

# SQLite auth file path (relative to project root). This is where credentials,
# signal keys, contacts, threads, and the message archive are upserted.
AUTH_PATH=.auth/state.sqlite

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info

# Reconnect settings (ms)
RECONNECT_DELAY_MS=2000
RECONNECT_MAX_ATTEMPTS=0
# 0 = retry forever; set e.g. 10 to give up after 10 failed attempts.

# Device fingerprint cosmetics
DEVICE_BROWSER=Chrome
DEVICE_OS=Windows

# ─── Optional: pairing-code flow ─────────────────────────────────
# Instead of scanning a QR, you can link via an 8-digit code entered on
# the phone (Settings → Linked devices → Link with phone number).
# Leave empty to use the QR flow. Set to a phone number in international
# format (digits only, e.g. 6281234567890) to enable the code flow.
PAIRING_PHONE=
